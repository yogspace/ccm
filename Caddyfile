# Internal static server in the ccm container (no TLS — the proxy stack does that).
{
    auto_https off
    admin off
}

:3000 {
    root * /srv
    encode zstd gzip

    # “/” to /de/ or /en/ by browser language – the hash of a shared link (#…)
    # survives redirects in the browser. `map` and `redir` run before
    # `try_files`, which would otherwise rewrite “/” already.
    map {header.Accept-Language} {lang} {
        ~(?i)^\s*de de
        default en
    }
    header / Vary Accept-Language
    redir / /{lang}/ 302

    # Vite assets carry a hash in their name → may be cached forever.
    @assets path /assets/*
    header @assets Cache-Control "public, max-age=31536000, immutable"

    # Counter API (container ccm-api, see docker-compose.yml).
    handle /api/* {
        reverse_proxy ccm-api:3001
    }

    # SPA fallback: the language pages are /de/index.html and /en/index.html,
    # anything unknown ends up at the English root.
    handle {
        try_files {path} {path}/index.html /index.html
        file_server
    }
}
