# Copy to .env (never committed). On the server the deploy writes it from the
# repository's secrets, same names (see README → Secrets).

# ── App ──────────────────────────────────────────────────────────────────────
# Public address of the site, no trailing slash (links in the mail report).
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Random secret for the admin login (at least 32 characters):
#   openssl rand -hex 32
PAYLOAD_SECRET=

# ── Sync (local only) ────────────────────────────────────────────────────────
# The server's SSH host alias (~/.ssh/config) for `pnpm payload:sync`.
SYNC_REMOTE=

# ── Database ─────────────────────────────────────────────────────────────────
# Local: the MongoDB from docker-compose.dev.yml. On the server
# docker-compose.yml sets it itself (mongodb://mongo:27017/ccm).
DATABASE_URL=mongodb://localhost:27018/ccm

# ── First admin ──────────────────────────────────────────────────────────────
# Created at start as long as there is no user (src/stats/seed-admin.ts) –
# otherwise /admin offers “create first user” to whoever comes first. Can go
# once the account exists.
PAYLOAD_ADMIN_EMAIL=
PAYLOAD_ADMIN_PASSWORD=

# ── Mail (contact form, report) ──────────────────────────────────────────────
# Resend (HTTPS – Hetzner blocks SMTP). Without these nothing is sent.
RESEND_API_KEY=
# Sender on a domain verified at Resend, e.g. Cookie Cutter Maker <ccm@example.com>
MAIL_FROM=
# Who gets the contact form's messages (the imprint).
MAIL_CONTACT_RECIPIENT=

# ── Mail report (optional) ───────────────────────────────────────────────────
# The cron route /next/cron/stats-digest is only allowed with this secret
# (or a logged-in admin):  openssl rand -hex 32
CRON_SECRET=
# Who gets the report.
MAIL_STATS_RECIPIENT=
